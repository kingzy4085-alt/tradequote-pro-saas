# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security — used for Stripe webhooks and invites.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used in auth emails and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — create a recurring Price in CAD and paste its id
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
# Set to true once Stripe Tax is enabled, so GST/HST/PST is calculated at checkout
STRIPE_AUTOMATIC_TAX=false

# Claude API — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
# ANTHROPIC_MODEL=
