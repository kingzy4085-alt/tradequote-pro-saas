# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security — used for Stripe webhooks and invites.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used in auth emails and Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — create a recurring Price in CAD and paste its id
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
# Set to true once Stripe Tax is enabled, so GST/HST/PST is calculated at checkout
STRIPE_AUTOMATIC_TAX=false

# Claude API — https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
# ANTHROPIC_MODEL=

# Trial onboarding emails, sent daily by /api/cron/trial-emails (scheduled in vercel.json)
# A long random string (32+ characters). Vercel sends it to every scheduled job automatically.
CRON_SECRET=
# Another long random string, separate from CRON_SECRET, that signs unsubscribe links.
# If empty, CRON_SECRET signs them. Changing it later breaks unsubscribe links already sent.
UNSUBSCRIBE_SECRET=
# Resend (https://resend.com): verify your domain, then create an API key
RESEND_API_KEY=
EMAIL_FROM=TradeQuote PRO <hello@your-domain.ca>
EMAIL_REPLY_TO=
# Required in every commercial email under Canada's anti-spam law (a PO box is fine)
BUSINESS_NAME=
BUSINESS_MAILING_ADDRESS=

# Daily automation (/api/cron/automation, /digest, /status, /job-costs in vercel.json) uses the settings above.
# With no RESEND_API_KEY, alerts still show in the app and emails are skipped and logged.
# Who gets told when it fails or stops running, and when someone signs up on the pricing page. Defaults to EMAIL_REPLY_TO.
# OPERATOR_EMAIL=
